# Copy to .env and fill in before deploying anywhere reachable by others.

# Comma-separated list of origins allowed to call this API. Do NOT leave as "*"
# once this is deployed somewhere public — lock it to your frontend's actual origin.
ALLOWED_ORIGINS=https://claude.ai

# If set, every request must include header  X-API-Key: <this value>
# Leave unset only for local, single-user testing.
API_KEY=change-me-before-deploying

# Max /process calls per IP per hour. Demucs+Whisper are expensive to run —
# keep this low unless you have the compute budget to back it up.
RATE_LIMIT_PER_HOUR=10
